Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.time-backups(/|$) - [F,L]
  RewriteRule \.upload-[a-f0-9]+$ - [F,L]
  RewriteRule (^|/)\.(env|git|netrc) - [F,L]
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), fullscreen=(self)"
  <FilesMatch "^(index\.html|sw\.js|release\.json|manifest\.webmanifest|app\.js|style\.css|themes\.js|picture\.js|earth\.js|solar\.js|icons\.js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType application/javascript .mjs
</IfModule>
