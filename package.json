{
  "name": "timescreen",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "An elegant fullscreen HTML5 clock for a spare vertical monitor, with 60 paired themes and live Earth illumination.",
  "license": "MIT",
  "author": "Paul Fleury",
  "homepage": "https://time.paulfleury.com",
  "repository": { "type": "git", "url": "https://github.com/paulfxyz/timescreen.git" },
