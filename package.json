{
  "name": "timescreen",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "A native macOS and web clock with 28 scene designs, 60 paired palettes, live Earth illumination, and offline support.",
  "license": "MIT",
  "author": "Paul Fleury",
  "homepage": "https://time.paulfleury.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/paulfxyz/timescreen.git"
  },
  "scripts": {
    "start": "serve public -l 3000 --no-clipboard",
    "test": "node --test tests/*.test.mjs",
    "setup:assets": "node tools/setup-assets.mjs",
    "build": "npm run setup:assets && node tools/build.mjs",
    "build:mac": "bash macos/scripts/build.sh",
    "build:dmg": "bash macos/scripts/dmg.sh"
  },
  "dependencies": {
    "esbuild": "^0.25.0",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "serve": "^14.2.4",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "compression": "^1.8.2",
    "fast-uri": "^3.1.9"
  }
}
